{
  "name": "packlink/woocommerce-dev",
  "description": "Packlink PRO WooCommerce Integration (Patched with TaskRunner killswitch)",
  "version": "3.6.1",
  "type": "wordpress-plugin",
  "repositories": [
    {
      "type": "vcs",
      "url": "https://github.com/kodekrakan-commerce/packlink-integration-core.git"
    }
  ],
  "require": {
    "php": ">=5.6",
    "packlink/integration-core": "dev-wl/perf-taskrunner-killswitch",
    "ext-json": "*",
    "ext-curl": "*",
    "ext-zip": "*",
    "iio/libmergepdf": "3.0.0"
  },
  "autoload": {
    "psr-4": {
      "Packlink\\WooCommerce\\": ""
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Logeecom\\Tests\\Infrastructure\\": "vendor/packlink/integration-core/tests/Infrastructure",
      "Logeecom\\Tests\\BusinessLogic\\": "vendor/packlink/integration-core/tests/BusinessLogic",
      "Logeecom\\Tests\\Brands\\": "vendor/packlink/integration-core/tests/Brands"
    }
  },
  "require-dev": {
    "phpunit/phpunit": "^5.4.0",
    "yoast/phpunit-polyfills": "^1.0",
    "phpunit/php-code-coverage":"^4.0"
  },
  "config": {
    "platform": {
      "php": "5.6.0"
    }
  },
  "scripts": {
    "post-update-cmd": "php ./copy-resources.php",
    "post-install-cmd": "php ./copy-resources.php"
  }
}
